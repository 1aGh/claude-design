{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maude",
  "version": "0.36.1",
  "identifier": "com.maude.app",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/sync-sidecar.mjs && node scripts/stage-resources.mjs",
    "beforeDevCommand": "node scripts/sync-sidecar.mjs && node scripts/stage-resources.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Maude",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:*; frame-src http://localhost:*; script-src 'self' 'unsafe-inline' http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:* asset:; connect-src http://localhost:* ws://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://maude.sh/releases/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCRDc0NTEzMjg2OEY1OEQKUldTTjlXZ29FMFhYaTdLRDVML21INzM2NWI5cXBveUp5MFVOcjJ1Rzc0clhKbTdDYkFsZjlZZ0gK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/maude-server"],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "resources/apps/studio": "apps/studio",
      "resources/plugins/design/templates": "plugins/design/templates"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
