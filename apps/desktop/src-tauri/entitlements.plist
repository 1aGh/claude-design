<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Developer ID + notarization entitlements (NOT App Store — no app-sandbox).

  The bundled dev-server sidecar (binaries/maude-server) is a `bun --compile`
  binary; Bun embeds JavaScriptCore, which JITs. Under the hardened runtime
  (mandatory for notarization, tauri.conf bundle.macOS.hardenedRuntime=true)
  JIT is blocked unless these entitlements are present, so without them the
  sidecar crashes at launch and the canvas never loads.

    allow-jit                         — permit the JSC JIT (MAP_JIT pages)
    allow-unsigned-executable-memory  — JSC writes+executes generated code
    disable-library-validation        — the app spawns/loads the separately
                                         built sidecar + its embedded runtime
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
