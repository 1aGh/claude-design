{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "node_modules",
      "**/node_modules/**",
      ".changeset/**/*.md",
      ".ai/**",
      ".design/**",
      "plugins/**/dist/**",
      "plugins/design/dev-server/client/**",
      "plugins/design/dev-server/runtime/**",
      "plugins/design/dev-server/server.mjs",
      "site/.next/**",
      "site/.source/**",
      "site/.vercel/**",
      "site/app/mdcc-tokens.css",
      "site/content/docs/reference/**",
      "site/out/**",
      "site/next-env.d.ts",
      "pnpm-lock.yaml",
      "scripts/video/.work/**",
      "scripts/video/.cache/**",
      "scripts/video/final/node_modules/**",
      "scripts/video/final/out/**",
      "scripts/video/final/__goldens__/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useNodejsImportProtocol": "warn"
      },
      "suspicious": {
        "noConsole": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      }
    }
  },
  "overrides": [
    {
      "include": ["plugins/design/dev-server/comments-overlay.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "useKeyWithClickEvents": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    }
  ]
}
