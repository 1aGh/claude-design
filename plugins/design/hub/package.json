{
  "name": "@maude/hub",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable Yjs sync hub for Maude cross-machine canvas collaboration (Phase 9). See .ai/plans/phase-9-self-hosted-hub-file-sync.md and .ai/decisions/DDR-052-hocuspocus-over-partykit-for-hub.md.",
  "type": "module",
  "main": "src/server.mjs",
  "bin": {
    "maude-hub": "dist/hub.bundle.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "build": "bun run build.ts",
    "build:dry": "bun run build.ts --dry-run",
    "dev": "node --watch src/server.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "@hocuspocus/extension-sqlite": "^4.0.0",
    "@hocuspocus/server": "^4.0.0",
    "better-sqlite3": "^12.10.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.0.0"
  }
}
