{
  "name": "@maude/dev-server",
  "version": "0.0.0",
  "private": true,
  "description": "Internal workspace for the canvas dev server. Source ships via the @1agh/maude tarball; this package.json never publishes. Bun runtime authoritative — see DDR-009.",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "build": "bun run build.ts",
    "build:watch": "bun --watch run build.ts",
    "test": "bun test",
    "typecheck": "bun tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.3.14",
    "lightningcss": "^1.27.0",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.131.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "pixi.js": "^8"
  }
}
