{
  "name": "@maude/dev-server",
  "version": "0.0.0",
  "private": true,
  "description": "Internal workspace for the canvas dev server. Source ships via the @1agh/maude tarball; this package.json never publishes. Bun runtime authoritative — see DDR-009.",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "build": "bun run build.ts",
    "build:watch": "bun --watch run build.ts",
    "test": "bun test",
    "typecheck": "bun tsc --noEmit"
  },
  "devDependencies": {
    "@oxc-parser/binding-darwin-arm64": "0.132.0",
    "@oxc-parser/binding-darwin-x64": "0.132.0",
    "@oxc-parser/binding-linux-arm64-gnu": "0.132.0",
    "@oxc-parser/binding-linux-arm64-musl": "0.132.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.132.0",
    "@oxc-parser/binding-linux-x64-musl": "0.132.0",
    "@oxc-parser/binding-win32-x64-msvc": "0.132.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.3.14",
    "lightningcss": "^1.27.0",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.132.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dom-to-pptx": "^1.1.9",
    "dom-to-svg": "^0.12.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pixi.js": "^8",
    "pptxgenjs": "^4.0.1"
  }
}
