# deps
/node_modules

# generated content
.source
# `content/docs/reference/` is auto-generated by site/scripts/build-{command,schema}-reference.mjs.
# It IS committed because Vercel uploads only `site/` (not the monorepo plugins/ siblings),
# so the build step on Vercel can't regenerate it from source. Run `pnpm --filter @md-claude/site gen:reference`
# after editing `plugins/{flow,design}/commands/*.md` or `plugins/flow/.claude-plugin/config.schema.json`
# and commit the diff.

# test & build
/coverage
/.next/
/out/
/build
*.tsbuildinfo

