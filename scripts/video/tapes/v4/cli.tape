Output scripts/video/final/public/v4/cli.mp4
Require maude
Set Shell "bash"
Set FontSize 30
Set Width 1600
Set Height 900
Set Padding 50
Set TypingSpeed 55ms
Set Theme { "background": "#14161c", "foreground": "#eef0f4", "cursor": "#7b88ff", "selection": "#2b3350", "black": "#14161c", "red": "#e06b5e", "green": "#5fd3a3", "yellow": "#d8b46a", "blue": "#7b88ff", "magenta": "#c08be0", "cyan": "#6bc0d8", "white": "#eef0f4", "brightBlack": "#5a6172", "brightGreen": "#7fe3bf", "brightBlue": "#9aa6ff", "brightWhite": "#ffffff" }
Sleep 600ms
Type "maude --version"
Sleep 400ms
Enter
Sleep 1200ms
Type "maude init --dry-run --name recipe-recap"
Sleep 400ms
Enter
Sleep 2200ms
Type "maude design help"
Sleep 400ms
Enter
Sleep 3500ms
