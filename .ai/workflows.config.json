{
  "$schema": "https://raw.githubusercontent.com/1aGh/maude/main/plugins/flow/.claude-plugin/config.schema.json",
  "name": "maude",
  "language": "en",
  "theme": "agnostic",
  "paths": {
    "prd": ".ai/maude-prd.md",
    "designSystem": ".ai/maude-design-system.md",
    "codebaseMap": ".ai/context/codebase-map.md"
  },
  "platforms": ["web-desktop"],
  "stack": {
    "language": "typescript",
    "framework": "next.js",
    "packageManager": "pnpm",
    "buildTool": "none",
    "monorepo": true,
    "ci": "github-actions",
    "tests": "unknown",
    "css": "none",
    "router": "next-app"
  },
  "conventions": {
    "branchingModel": "github-flow",
    "commits": "conventional",
    "prohibited": []
  },
  "boundaries": {
    "realtime": [],
    "video": [],
    "api": [],
    "db": [],
    "auth": [],
    "telemetry": [],
    "payments": []
  },
  "motion": {
    "micro": 300,
    "page": 500,
    "complex": 1000,
    "customPulses": { "canvasActivity": 2200 }
  },
  "responsive": {
    "approach": "mobile-first",
    "densityMap": {
      "web-desktop": "cozy"
    },
    "breakpoints": {
      "sm": 480,
      "md": 768,
      "lg": 1024,
      "xl": 1280,
      "2xl": 1536
    }
  },
  "ux": {
    "responseTargetMs": 100,
    "bilingual": []
  },
  "skills": {
    "motionRules": {
      "enabled": true
    },
    "responsiveRules": {
      "enabled": true
    },
    "a11yRules": {
      "enabled": true
    },
    "testingRules": {
      "enabled": true
    },
    "debuggingRules": {
      "enabled": true
    }
  },
  "integrations": {
    "tracker": {
      "provider": "github"
    },
    "analytics": {
      "provider": "none"
    },
    "ci": {
      "provider": "none"
    },
    "design": {
      "provider": "none"
    },
    "changelog": {
      "provider": "changesets",
      "releaseGuide": ".ai/release-guide.md",
      "scope": "@1agh/maude"
    },
    "whatsNew": {
      "enabled": true,
      "feed": "plugins/design/dev-server/whats-new.json",
      "skill": "whats-new-entry"
    }
  },
  "quality": {
    "lint": "pnpm lint",
    "format": "pnpm format",
    "tests": "pnpm test && pnpm test:dev-server",
    "build": "pnpm --filter @maude/site build",
    "parity": "bash scripts/check-version-parity.sh",
    "tarball": "bash scripts/check-tarball-shape.sh",
    "tokens": "pnpm --filter @maude/site sync:tokens:check",
    "site-content": "pnpm --filter @maude/site gen:reference && pnpm --filter @maude/site gen:stats && { git diff --quiet -- site/content/docs/ site/lib/stats.json || { echo \"site reference/stats stale — commit the regen diff\"; exit 1; }; }"
  }
}
