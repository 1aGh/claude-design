node_modules/
*.log
.DS_Store

# dev-server runtime artifacts (anything the server writes outside the plugin)
dev-server/.cache/

# .design/ runtime — per-machine / per-user state. Canonical IGNORED set is the
# DDR-115 runtime-state taxonomy (kept in lockstep with cli/lib/gitignore-block.mjs
# + apps/studio/git/service.ts isMaudeRuntimeState). VERSIONED content
# (config.json / README.md / INDEX.md / system/ / *.meta.json / *.annotations.svg)
# is NOT ignored. Comments stay ignored (hub-sync-only, DDR-102/DDR-115).
.design/_server.json
.design/_server.log
.design/_server.lock
.design/_active.json
.design/_sync.json
.design/_preflight.json
.design/_locator.json
.design/_export-history.json
.design/_history/
.design/_trash/
.design/_draw/
.design/_smoke/
.design/_comments/
.design/_canvas-state/
.design/_chat/
.design/_untrusted/
# Auto-managed by the linked-mode sync runtime (lists hub-synced UNTRUSTED files).
# Machine-local state, regenerated on sync — never committed.
.claudeignore

# Phase 8 / DDR-051 — Yjs collab cache. JSON snapshots in _comments/ remain the
# canonical persistence format; `.ydoc.bin` is regenerated from JSON on cold open.
.design/_state/*
!.design/_state/.gitkeep

# Phase C / DDR-061 — sidecar cache (cli/lib/cache.mjs). The research/domain
# and codebase-intelligence layers ARE committed (SHA-keyed, shareable across
# collaborators — mirrors the site/lib/roadmap.json "commit it" decision). The
# brief/run/HEAD-specific layers + local telemetry stay out of git.
.ai/cache/*
!.ai/cache/codebase-intelligence/
!.ai/cache/research/
.ai/cache/research/*
!.ai/cache/research/domain/

# AI workflow runtime — committed templates live in .ai/templates/
.ai/state/HANDOFF.md
.ai/device/
.ai/browser/
.ai/scenarios/**/baseline-staging/
# Per-run scenario artifacts (timestamped folders). spec.md / README.md / aggregate reports are committed; PNGs + per-run report.md are local-only.
.ai/scenarios/**/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]/
.ai/logs/
.claude/settings.local.json
.claude/worktrees/

# Phase 3.4 — dev-server build output (binaries ship via npm sub-packages).
# Phase 19 / DDR-044 — client.bundle.js + styles.css ARE committed so
# marketplace cache installs (which honor .gitignore on git clone) work
# out of the box. Per-platform `maude-*` binaries stay ignored (~70-120 MB
# each — distributed via @1agh/maude-<platform> sub-packages).
apps/studio/dist/*
!apps/studio/dist/client.bundle.js
!apps/studio/dist/comment-mount.js
!apps/studio/dist/styles.css
# v0.18.1 (Phase 19.1) — pre-built /_canvas-runtime/*.js bundles ship in git
# so npm-installed users don't need node_modules/react on disk to render TSX.
!apps/studio/dist/runtime/
!apps/studio/dist/runtime/*.js
apps/studio/bun.lock

# Stub .keep written by dev-server before the inspect.ts fix landed (Phase 3.4)
.design/.keep

# DDR-115 — `*.annotations.svg` is VERSIONED (durable visual markup, no other
# transport). It is deliberately NOT ignored; it travels via git + shows in the
# Changes panel. (Was ignored pre-DDR-115; flipped to versioned per user decision.)

# Postinstall/serve side-channel cache (machine-specific compiled-binary path)
cli/.platform-binary-path
