# + apps/studio/git/service.ts isMaudeRuntimeState). VERSIONED content
# (config.json / README.md / INDEX.md / system/ / *.meta.json / *.annotations.svg)
# is NOT ignored. Comments stay ignored (hub-sync-only, DDR-102/DDR-115).
.design/_server.json
.design/_server.log
.design/_server.lock
.design/_active.json
.design/_sync.json
.design/_preflight.json
.design/_locator.json
.design/_export-history.json
.design/_export-jobs/
.design/_generate-history.json
.design/_history/
.design/_trash/
.design/_draw/
.design/_photo/
.design/_smoke/
.design/_comments/
.design/_canvas-state/
.design/_chat/
.design/_untrusted/
# kgai knowledge-graph store. The split is LOG (durable truth) vs CACHE/IDENTITY
# (per-machine) — kgai's own store-level .gitignore draws the same line:
#   • log/*.ndjson  → VERSIONED. The append-only decision log IS the knowledge.
#     824 KB, one file PER INSTALL ID (so two machines never write the same file)
#     and `.gitattributes` marks it `merge=union` — it merges without conflicts.
#     Verified: deleting graph.kuzu and running `kg rebuild` restores all 189
#     decisions / 566 elements from the log alone. Committing it is what lets
#     someone clone this repo and inherit the full decision context.
#   • graph.kuzu (22 MB), kg.config.json (the per-machine INSTALL IDENTITY),
#     .kg.lock → IGNORED. The projection is derived (`kg rebuild`); sharing the
#     install identity is what forks a shard (kgai's own remedy: `kg rotate`).
# ⚠ If this store is ever pointed at a SHARED COMPANY remote, the log will carry
#   other teams' decisions — do NOT commit it to a public repo then (DDR-189).
.kgai/*
!.kgai/store
.kgai/store/*
!.kgai/store/log
# Auto-managed by the linked-mode sync runtime (lists hub-synced UNTRUSTED files).
# Machine-local state, regenerated on sync — never committed.
.claudeignore

# Phase 8 / DDR-051 — Yjs collab cache. JSON snapshots in _comments/ remain the
# canonical persistence format; `.ydoc.bin` is regenerated from JSON on cold open.
.design/_state/*
!.design/_state/.gitkeep

# Phase C / DDR-061 — sidecar cache (cli/lib/cache.mjs). The research/domain
# and codebase-intelligence layers ARE committed (SHA-keyed, shareable across
# collaborators — mirrors the site/lib/roadmap.json "commit it" decision). The
# brief/run/HEAD-specific layers + local telemetry stay out of git.
.ai/cache/*
!.ai/cache/codebase-intelligence/
!.ai/cache/research/
.ai/cache/research/*
!.ai/cache/research/domain/

# AI workflow runtime — committed templates live in .ai/templates/
.ai/state/HANDOFF.md
.ai/device/
.ai/browser/
.ai/scenarios/**/baseline-staging/
# Per-run scenario artifacts (timestamped folders). spec.md / README.md / aggregate reports are committed; PNGs + per-run report.md are local-only.
.ai/scenarios/**/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]/
.ai/logs/
# Same rule after the archive move (2026-07-28): the RCA/review prose is now IN
# the knowledge graph (full body, committed via .kgai/store/log), so tracking
# 1.1 MB of it again here would be pure duplication. `.ai/archive/decisions/`
# stays VERSIONED — it is the authoring surface + the git-native backup.
.ai/archive/logs/
.claude/settings.local.json
.claude/worktrees/

# Phase 3.4 — dev-server build output (binaries ship via npm sub-packages).
# Phase 19 / DDR-044 — client.bundle.js + styles.css ARE committed so
# marketplace cache installs (which honor .gitignore on git clone) work
# out of the box. Per-platform `maude-*` binaries stay ignored (~70-120 MB
# each — distributed via @1agh/maude-<platform> sub-packages).
apps/studio/dist/*
!apps/studio/dist/client.bundle.js
!apps/studio/dist/comment-mount.js
!apps/studio/dist/styles.css
# v0.18.1 (Phase 19.1) — pre-built /_canvas-runtime/*.js bundles ship in git
# so npm-installed users don't need node_modules/react on disk to render TSX.
!apps/studio/dist/runtime/
!apps/studio/dist/runtime/*.js
apps/studio/bun.lock

# Stub .keep written by dev-server before the inspect.ts fix landed (Phase 3.4)
.design/.keep

# DDR-115 — `*.annotations.svg` is VERSIONED (durable visual markup, no other
# transport). It is deliberately NOT ignored; it travels via git + shows in the
# Changes panel. (Was ignored pre-DDR-115; flipped to versioned per user decision.)

# Postinstall/serve side-channel cache (machine-specific compiled-binary path)
cli/.platform-binary-path

# Local env files — may hold API keys (feature-ai-media-generation); never commit.
.env.local
.env*.local
# (A blanket `.kgai/` rule lived here. Removed deliberately: gitignore is
# last-match-wins, so it silently re-ignored `.kgai/store/log/` and defeated the
# log-vs-cache split defined above — see the kgai block near the top, which
# already ignores the store's cache + install identity, just more precisely.)
# DO NOT re-add a blanket `.kgai/` here. It has been appended twice by other
# sessions; because gitignore is last-match-wins it silently re-ignores
# `.kgai/store/log/`, which the owner explicitly wants versioned so a clone
# inherits the decision context. The block above already ignores the 22 MB
# projection and the per-machine install identity.
# kgai per-project knowledge graph store (own git/sync cycle)
.kgai/
