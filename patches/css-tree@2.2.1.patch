diff --git a/lib/data-patch.js b/lib/data-patch.js
index cd49cbec3e7de20dea750e95e007dbdb1488ac96..9d776a635b3b09d439857719c465a114e5736cf1 100644
--- a/lib/data-patch.js
+++ b/lib/data-patch.js
@@ -1,6 +1,9 @@
-import { createRequire } from 'module';
-
-const require = createRequire(import.meta.url);
-const patch = require('../data/patch.json');
+// Patched (bun --compile compat): the original createRequire(import.meta.url)
+// + require('../data/patch.json') pattern isn't statically analyzable by
+// bun's bundler, so it isn't embedded — the compiled standalone binary then
+// tries to resolve the relative path against its virtual /$bunfs/root at
+// runtime and fails ("Cannot find module '../data/patch.json'"). A static
+// JSON import assertion is bundler-inlinable and has no runtime file lookup.
+import patch from '../data/patch.json' with { type: 'json' };
 
 export default patch;
